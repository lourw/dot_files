alias debug='kubectl run debug --image ubuntu -- sleep 3600'
alias ports='lsof -i -P -n | grep LISTEN'

export EDITOR=nvim
# mise.run installs mise here on apt distros
export PATH="$HOME/.local/bin:$PATH"
export PATH="~/.local/share/mise/shims:$PATH"

# --- ALIASES ---
# ~/.zshconf is a symlink into the repo, so resolve the repo location from it
DOTFILES_DIR="$(dirname "$(dirname "$(readlink -f ~/.zshconf)")")"
alias df='cd $DOTFILES_DIR'
alias e='nvim'
alias h='cd ~'
alias ls="ls --color=auto"
alias notes='cd ~/notes && nvim $(date '+%y-%m-%d').md'
alias precommit-config='nvim .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit'
alias sane='stty sane'
alias tmuxconfig='nvim ~/.config/tmux/tmux.conf'
alias vimconfig='nvim ~/.config/nvim/lua/configs'
alias zshconfig='nvim ~/.zshconf && source ~/.zshrc'
alias ap='ansible-playbook $DOTFILES_DIR/ansible/playbook.yaml --ask-become-pass'

# --- ALIASES FOR TOOLS ---
alias cat='bat'
alias fcd='cd $(fd -L --type d . ~ | fzf)'
alias f='nvim $(fd . | fzf)'
alias vim='nvim'

# --- ALIASES FOR BASH SCRIPTS ---
alias killp='kill_process_on_port'
alias t='test'

# --- git ---
alias rebase='git fetch origin main:main && git rebase main'

# --- PATH ---

# --- zsh configs ---
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks

# Completions: run compinit once, with every completion dir already on fpath. A second
# compinit after fpath changes sees a different file count and rebuilds ~/.zcompdump,
# so put Docker Desktop's dir here; its ~/.zshrc block then skips its own compinit
[[ -d ~/.docker/completions ]] && fpath=(~/.docker/completions $fpath)
autoload -Uz compinit
# -C trusts the existing dump (and still creates it if missing); do the full check and
# rebuild only once it is a day old, so newly installed completions show up within a day
() {
  if (( $# )); then compinit; else compinit -C; fi
} ~/.zcompdump(N.mh+24)
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --- prompt ---
source "$DOTFILES_DIR/zsh/prompt.zsh"

# Use two tabs to accept autosuggest
bindkey '\t\t' autosuggest-accept

# --- Kubernetes ---
alias debug='kubectl run debug --image ubuntu -- sleep 3600'
alias ports='lsof -i -P -n | grep LISTEN'

export EDITOR=nvim
# Placeholder key for the local llama-server, which ignores it (dsh needs one set)
export LLAMA_SERVER_API_KEY=llama-server
# mise.run installs mise here on apt distros
export PATH="$HOME/.local/bin:$PATH"
export PATH="~/.local/share/mise/shims:$PATH"
eval "$(mise activate zsh)"

set -o vi 

# Ensure that backspace in vi mode will delete past inserted characters
bindkey "^H" backward-delete-char
bindkey "^?" backward-delete-char

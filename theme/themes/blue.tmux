# Blue theme: Tokyo Night blue accents with light blue text on deep blue segments.
# Same format as the other themes in this folder.
set -g @theme_bg         "#16161e"   # bar and dark backgrounds
set -g @theme_on_accent  "#16161e"   # text on accent blocks
set -g @theme_surface    "#283457"   # deep blue segments and inactive tabs
set -g @theme_fg         "#c8d8ff"   # main text
set -g @theme_muted      "#7dcfff"   # light blue text: inactive tabs, branch and worktree
set -g @theme_subtle     "#3d59a1"   # thin dividers
set -g @theme_accent     "#7aa2f7"   # active tab, folder, session block, prompt icon
set -g @theme_warn       "#e0af68"   # prefix held, Claude waiting
set -g @theme_error      "#f7768e"   # prompt char after a failed command

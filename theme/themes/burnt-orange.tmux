# Garnet theme: dark orange accents with peach text on dark brown segments.
# Same format as the other themes in this folder.
set -g @theme_bg          "#16161e"   # bar and dark backgrounds
set -g @theme_on_accent   "#16161e"   # text on accent blocks
set -g @theme_surface     "#3a2a20"   # dark brown segments and inactive tabs
set -g @theme_fg          "#f2dccd"   # main text
set -g @theme_muted       "#f2c1a0"   # peach text: inactive tabs, branch and worktree
set -g @theme_subtle      "#6b4a35"   # thin dividers
set -g @theme_accent      "#cc5f24"   # active tab, folder, session block, prompt icon
set -g @theme_warn        "#e0af68"   # prefix held, Claude waiting
set -g @theme_error       "#f7768e"   # prompt char after a failed command

# Turquoise theme: turquoise accents with aqua text on dark teal segments.
# Same format as the other themes in this folder.
set -g @theme_bg          "#16161e"   # bar and dark backgrounds
set -g @theme_on_accent   "#16161e"   # text on accent blocks
set -g @theme_surface     "#1d3b3a"   # dark teal segments and inactive tabs
set -g @theme_fg          "#d6f5f1"   # main text
set -g @theme_muted       "#a8f0e6"   # aqua text: inactive tabs, branch and worktree
set -g @theme_subtle      "#3a6b67"   # thin dividers
set -g @theme_accent      "#2ac3b4"   # active tab, folder, session block, prompt icon
set -g @theme_warn        "#e0af68"   # prefix held, Claude waiting
set -g @theme_error       "#f7768e"   # prompt char after a failed command
